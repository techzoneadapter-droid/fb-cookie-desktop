{
  "name": "fb-cookie-token-tool",
  "version": "1.4.9",
  "description": "FB Cookie & Access Token Tool - Chi dung cho Facebook",
  "main": "main.js",
  "author": "Local Tool",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir",
    "publish": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.fb-cookie-token",
    "productName": "FB Cookie Token Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FB Cookie Token Tool",
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "techzoneadapter-droid",
        "repo": "fb-cookie-desktop"
      }
    ]
  }
}
